{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "core:window:allow-theme",
    "core:window:allow-set-theme",
    "core:window:allow-show"
  ]
}
