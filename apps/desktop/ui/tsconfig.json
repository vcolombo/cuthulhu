{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // e2e is included so `npm run build` typechecks the fake backend too: it mirrors
  // Document::snapshot_json(), and a Node literal that drops a required field there would
  // otherwise reach Playwright's transpile-only run unchecked and read as a silent default.
  "include": ["src", "e2e"]
}
